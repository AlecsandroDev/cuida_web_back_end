# --- Servidor / Supabase (já existentes) ---
PORT_SERVER=3000
SUPABASE_URL=
SUPABASE_KEY=
JWT_SECRET=

# --- Evolution API ---
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_API_KEY=troque-esta-chave
WHATSAPP_INSTANCE=cuida
# v1 = payload { textMessage: { text } }  |  v2 = payload { text }
EVOLUTION_API_VERSION=v1

# --- Anti-banimento (valores padrão) ---
WHATSAPP_INTERVALO_MIN_MS=8000
WHATSAPP_INTERVALO_MAX_MS=20000
WHATSAPP_PAUSA_A_CADA=15
WHATSAPP_PAUSA_MIN_MS=60000
WHATSAPP_PAUSA_MAX_MS=180000
WHATSAPP_DIGITANDO_MIN_MS=1500
WHATSAPP_DIGITANDO_MAX_MS=4000
# Janela de envio (horário de Brasília). Use 0 e 24 para desligar.
WHATSAPP_HORA_INICIO=8
WHATSAPP_HORA_FIM=20
# Consulta /chat/whatsappNumbers antes de enviar (resolve o 9º dígito)
WHATSAPP_VERIFICAR_NUMERO=true

# --- Proteção do disparo em massa (header x-api-key). Vazio = sem proteção ---
NOTIFICACAO_API_KEY=
